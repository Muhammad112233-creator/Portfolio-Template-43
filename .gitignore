# ── OS noise ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editors / IDEs ──────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# ── Logs & temp ─────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.tmp/
.temp/
*.bak

# ── Env & secrets ───────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Dependencies (this template ships none, but just in case) ──
node_modules/
.pnpm-store/
.yarn/

# ── Build output (none by default) ──────────
dist/
build/
out/
.next/
.nuxt/

# ── Screenshots / scratch ───────────────────
screenshots/*.png
!screenshots/.gitkeep
shots/
shots_*/
*.psd
